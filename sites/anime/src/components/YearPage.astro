---
/** One page of the anime that started in one year, most watched first. */
import Where from '@sister/core/src/layouts/Where.astro'
import config from '@sister/core/src/lib/site.mjs'
import Pager from '@sister/core/src/components/Pager.astro'
import { whereHubs } from '@sister/core/src/where/hub-data.mjs'
import { PER_YEAR_PAGE, pageSlice } from '@sister/core/src/where/hubs.mjs'
import { listJsonld } from '@sister/core/src/where/jsonld.mjs'
import { plural } from '@sister/core/src/where/words.mjs'
import Covers from '@sister/core/src/components/where/Covers.astro'
import { cardOfRow } from './card-row.mjs'

const { year, page, pages } = Astro.props
const rows = whereHubs().years[year]
const shown = pageSlice(rows, page, PER_YEAR_PAGE)
const base = `/year/${year}`
const top = rows.slice(0, 3).map((r) => r[0])
const items = shown.map(cardOfRow)
---

<Where
  title={`Anime of ${year}: All ${rows.length}${page > 1 ? `, page ${page}` : ''} | ${config.name}`}
  description={`Every anime that began in ${year}, most watched first: ${plural(rows.length, 'show')}${top.length ? `, led by ${top.join(', ')}` : ''}. Each with its episodes, cast and staff.`}
  canonical={page > 1 ? `${base}/${page}` : base}
  jsonld={listJsonld(`Anime of ${year}`, items, config.siteUrl)}
  crumbs={[{ name: 'Anime', href: '/anime' }, { name: 'By year', href: '/year' }, { name: String(year) }]}
>
  <header class="w-intro">
    <p class="w-kicker">Anime by year</p>
    <h1>Anime of {year}</h1>
    <p class="w-intro__lede">{plural(rows.length, 'show')} began in {year}, most watched first{pages > 1 ? `. Page ${page} of ${pages}` : ''}.</p>
  </header>
  <Covers items={items} eager={6} />
  <Pager current={page} count={pages} base={base} segment="" label={`${year} anime`} />
</Where>
