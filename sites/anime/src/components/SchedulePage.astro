---
/**
 * /schedule (drawn by pages/[hub].astro): every episode due in the coming
 * week, day by day, for the shows on this site. Built only when the week
 * passes its gate (enough dated episodes, packages/core/src/where/anime-hubs.mjs
 * buildSchedule), so the route lists its one path only then.
 *
 * Prerendered at the nightly build. The page is true in UTC as built; the
 * browser then does what a cached page cannot: it writes each time in the
 * reader's own clock, counts down to it, marks the reader's today and dims the
 * days already gone.
 *
 * Under the week: the most watched shows airing now, the anime announced but
 * not started (packages/core/src/where/schedule-lists.mjs, each list dropped
 * when too thin), and the questions the page answers.
 */
import Where from '@sister/core/src/layouts/Where.astro'
import config from '@sister/core/src/lib/site.mjs'
import HubHead from '@sister/core/src/components/where/HubHead.astro'
import Covers from '@sister/core/src/components/where/Covers.astro'
import Faq from '@sister/core/src/components/where/Faq.astro'
import { whereHubs } from '@sister/core/src/where/hub-data.mjs'
import { faqJsonld, listJsonld } from '@sister/core/src/where/jsonld.mjs'
import { listWords } from '@sister/core/src/where/faq.mjs'
import { plural } from '@sister/core/src/where/words.mjs'
import Countdown from '@sister/core/src/components/Countdown.astro'

const hubs = whereHubs()
const schedule = hubs.schedule
const WEEKDAYS = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday']
const MONTHS = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December']
const dayWords = (day) => {
  const d = new Date(`${day}T00:00:00Z`)
  return { weekday: WEEKDAYS[d.getUTCDay()], date: `${d.getUTCDate()} ${MONTHS[d.getUTCMonth()]}`, n: d.getUTCDate() }
}
const clock = (at) => new Date(at * 1000).toISOString().slice(11, 16)
const first = dayWords(schedule.days[0].day)
const last = dayWords(schedule.days.at(-1).day)
const shows = new Set(schedule.days.flatMap((d) => d.rows.map((r) => r[1]))).size
const busiest = schedule.days.reduce((a, b) => (b.rows.length > a.rows.length ? b : a))
const items = schedule.days.flatMap((d) => d.rows).map(([title, href]) => ({ title, href }))
const asItems = (rows) => rows.map(([title, href]) => ({ title, href }))

// Each announced list's heading, jump label and one line on how it is picked.
const UPCOMING_WORDS = {
  anticipated: { id: 'anticipated', title: 'Most anticipated anime', nav: 'Most anticipated', note: 'Not out yet, ranked by how many AniList users have each one on a list.' },
  big: { id: 'big-releases', title: 'Big upcoming releases', nav: 'Big releases', note: 'The most followed shows and films with an exact premiere date, soonest first.' },
  soon: { id: 'coming-soon', title: 'Coming soon', nav: 'Coming soon', note: 'Every other anime with an exact premiere date, soonest first.' },
  movies: { id: 'movies', title: 'Upcoming anime movies', nav: 'Movies', note: 'Announced films, soonest first. A month or a year means that is all that has been announced.' },
}
const popular = schedule.popular || []
const upcoming = (schedule.upcoming || []).map((list) => ({ ...UPCOMING_WORDS[list.key], rows: list.rows }))
const onWhat = (sites) => (sites?.length ? `On ${listWords(sites)}` : 'No official stream listed yet')

const today = schedule.days[0]
const todayWords = dayWords(today.day)
const faq = [
  {
    q: 'What anime airs today?',
    a: today.rows.length
      ? `${plural(today.rows.length, 'episode')} ${today.rows.length === 1 ? 'airs' : 'air'} on ${todayWords.weekday} ${todayWords.date} (UTC), including ${listWords(today.rows.slice(0, 5).map((r) => r[0]))}. Each one is listed above with the platforms that carry it.`
      : `No episode of a show on ${config.name} airs on ${todayWords.weekday} ${todayWords.date} (UTC). The rest of the week is listed above.`,
  },
  {
    q: 'Where can I watch these episodes legally?',
    a: `Each show links to its own page, which lists only the official streaming platforms AniList names for it, such as Crunchyroll or Netflix. ${config.name} hosts no video and links to no unofficial streams.`,
  },
  {
    q: 'What time zone are these times in?',
    a: 'Your own. The page is built in UTC, then your browser shows each time in your time zone and moves each episode to your own day. Each time is the first broadcast in Japan.',
  },
  {
    q: 'How often is this page updated?',
    a: 'Once a day. The airing calendar comes from AniList and the page is rebuilt every day, so an episode that moves is corrected within a day.',
  },
  upcoming.some((u) => u.id === 'anticipated') && {
    q: 'How are the most anticipated anime ranked?',
    a: 'By AniList popularity: how many AniList users have the title on one of their lists. For a show that is not out yet, that mostly counts people who plan to watch it.',
  },
  upcoming.length > 0 && {
    q: 'Why do some upcoming anime show only a month or a year?',
    a: 'Because that is all that has been announced. An exact day is shown only when AniList lists one, and a month, a season or a year when that is all it has.',
  },
].filter(Boolean)

const jumps = [
  { href: '#week', label: 'This week' },
  popular.length > 0 && { href: '#popular', label: 'Popular now' },
  ...upcoming.map((u) => ({ href: `#${u.id}`, label: u.nav })),
].filter(Boolean)

const season = hubs.home?.season
const jsonld = [
  listJsonld('Anime airing this week', items, config.siteUrl),
  popular.length > 0 && listJsonld('Most popular anime airing now', asItems(popular), config.siteUrl),
  ...upcoming.map((u) => listJsonld(u.title, asItems(u.rows), config.siteUrl)),
  faqJsonld(faq, '/schedule', config.siteUrl),
]
---

<Where
  title={`Anime Airing Schedule This Week: ${first.date} to ${last.date} | ${config.name}`}
  description={`Every anime episode airing from ${first.weekday} ${first.date} to ${last.weekday} ${last.date}: ${plural(schedule.total, 'episode')} of ${plural(shows, 'show')}, with the time each airs in your time zone and a countdown.`}
  canonical="/schedule"
  jsonld={jsonld}
  crumbs={[{ name: 'Anime', href: '/anime' }, { name: 'Airing schedule' }]}
>
  <HubHead
    kicker="Airing schedule"
    title="Anime airing this week"
    lede={`${first.weekday} ${first.date} to ${last.weekday} ${last.date}. Each time is the first broadcast in Japan, shown in your own time zone, with a countdown.`}
    stats={[[String(schedule.total), 'episodes'], [String(shows), 'shows'], [dayWords(busiest.day).weekday.slice(0, 3), 'busiest day']]}
  >
    <nav class="w-daytabs" aria-label="Days of the week">
      <ul>
        {
          schedule.days.map((d, i) => {
            const w = dayWords(d.day)
            return (
              <li>
                <a href={`#d-${d.day}`} data-day={d.day} class:list={[{ 'is-today': i === 0, 'is-empty': d.rows.length === 0 }]}>
                  <span class="w-daytabs__wd">{w.weekday.slice(0, 3)}</span>
                  <b>{w.n}</b>
                  <small>{d.rows.length ? plural(d.rows.length, 'ep') : 'none'}</small>
                </a>
              </li>
            )
          })
        }
      </ul>
    </nav>
    <p class="w-sched__zone" id="sched-zone">Times in UTC.</p>
  </HubHead>

  {
    jumps.length > 1 && (
      <nav class="w-jumps w-jumps--wrap" aria-label="On this page">
        <ul>
          {jumps.map((j) => (
            <li>
              <a href={j.href}>{j.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }

  <div class="w-sched" id="week">
    {
      schedule.days.map((d, i) => {
        const words = dayWords(d.day)
        return (
          <section class:list={['w-sched__day', { 'is-today': i === 0 }]} id={`d-${d.day}`} data-day={d.day} aria-labelledby={`h-${d.day}`}>
            <h2 id={`h-${d.day}`}>
              {words.weekday} <span>{words.date}</span>
              <em class="w-sched__today">Today</em>
            </h2>
            {d.rows.length ? (
              <ol class="w-sched__list">
                {d.rows.map(([title, href, cover, episode, at, planned, sites]) => (
                  <li>
                    <a href={href}>
                      {cover ? (
                        <img src={String(cover).replace('/cover/large/', '/cover/medium/')} alt="" width="64" height="91" loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
                      ) : (
                        <span class="w-sched__blank" />
                      )}
                      <span class="w-sched__what">
                        <time class="w-sched__clock" datetime={new Date(at * 1000).toISOString()} data-at={at}>
                          {clock(at)} UTC
                        </time>
                        <b>{title}</b>
                        <small>{`Episode ${episode}${planned ? ` of ${planned}` : ''}${planned && episode === planned ? ', final' : episode === 1 ? ', premiere' : ''}`}</small>
                        <small class:list={['w-sched__on', { 'is-none': !sites?.length }]}>{onWhat(sites)}</small>
                      </span>
                    </a>
                    <Countdown at={at} />
                  </li>
                ))}
              </ol>
            ) : (
              <p class="w-sched__none">No episodes of shows on {config.name} air this day.</p>
            )}
          </section>
        )
      })
    }
  </div>

  {
    popular.length > 0 && (
      <section class="w-sec" id="popular" aria-labelledby="h-popular">
        <div class="w-sec__head">
          <h2 id="h-popular">Most popular anime airing now</h2>
        </div>
        <p class="w-sec__note">The shows on the most AniList lists that are still airing, with the next episode and where it streams.</p>
        <ul class="w-starters w-onnow">
          {popular.map(([title, href, cover, episode, at, sites]) => (
            <li>
              <a href={href}>
                {cover ? <img class="w-thumb" src={cover} alt="" width="44" height="62" loading="lazy" decoding="async" /> : <span class="w-thumb" />}
                <span>
                  <b>{title}</b>
                  <small>
                    {at ? (
                      <>
                        Episode {episode}, <Countdown at={at} />
                      </>
                    ) : (
                      'Airing, next episode date not listed'
                    )}
                  </small>
                  <small class:list={['w-onnow__on', { 'is-none': !sites.length }]}>{onWhat(sites)}</small>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    upcoming.map((u) => (
      <section class="w-sec" id={u.id} aria-labelledby={`h-${u.id}`}>
        <div class="w-sec__head">
          <h2 id={`h-${u.id}`}>{u.title}</h2>
          <p class="w-sec__count">{plural(u.rows.length, 'title')}</p>
        </div>
        <p class="w-sec__note">{u.note}</p>
        <Covers
          items={u.rows.map(([title, href, cover, format, when]) => ({ title, href, cover, meta: [format, when || 'No date yet'].filter(Boolean).join(' · ') }))}
          size="sm"
          label={u.title}
        />
      </section>
    ))
  }

  <section class="w-sec" aria-labelledby="h-faq">
    <div class="w-sec__head">
      <h2 id="h-faq">Common questions</h2>
    </div>
    <Faq faq={faq} />
  </section>

  <nav class="w-sec" aria-label="Anime by season">
    <ul class="w-chips w-chips--links">
      {season && (
        <li>
          <a href={season.path}>This season: {season.label}</a>
        </li>
      )}
      {(hubs.seasonIndex || []).length > 0 && (
        <li>
          <a href="/season">Anime by season</a>
        </li>
      )}
    </ul>
  </nav>
</Where>

<script>
  // The reader's own clock: each time in their zone, their today marked, the
  // days before it dimmed. The page as built is true in UTC without this.
  const pad = (n: number) => String(n).padStart(2, '0')
  const dayOf = (d: Date) => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`
  const today = dayOf(new Date())
  const sections = new Map([...document.querySelectorAll<HTMLElement>('.w-sched__day')].map((s) => [s.dataset.day || '', s]))
  for (const node of document.querySelectorAll<HTMLElement>('.w-sched__clock')) {
    const at = new Date(Number(node.dataset.at) * 1000)
    node.textContent = at.toLocaleTimeString(undefined, { hour: 'numeric', minute: '2-digit' })
    // The page is cut into UTC days; an episode moves to the reader's own day
    // when that day is on the page, so "Friday" holds only Friday here.
    const item = node.closest('li')
    const home = sections.get(dayOf(at))
    if (!item || !home || home.contains(item)) continue
    let list = home.querySelector('.w-sched__list')
    if (!list) {
      list = document.createElement('ol')
      list.className = 'w-sched__list'
      home.querySelector('.w-sched__none')?.replaceWith(list)
    }
    list.append(item)
  }
  for (const [day, section] of sections) {
    const list = section.querySelector('.w-sched__list')
    const items = list ? [...list.children] : []
    items.sort((a, b) => Number(a.querySelector<HTMLElement>('[data-at]')?.dataset.at) - Number(b.querySelector<HTMLElement>('[data-at]')?.dataset.at))
    for (const item of items) list?.append(item)
    if (list && !items.length) {
      const none = document.createElement('p')
      none.className = 'w-sched__none'
      none.textContent = 'No episodes air this day in your time zone.'
      list.replaceWith(none)
    }
    const count = document.querySelector(`.w-daytabs a[data-day="${day}"] small`)
    if (count) count.textContent = items.length ? `${items.length} ep${items.length === 1 ? '' : 's'}` : 'none'
    count?.closest('a')?.classList.toggle('is-empty', !items.length)
  }
  const zone = Intl.DateTimeFormat().resolvedOptions().timeZone
  const note = document.getElementById('sched-zone')
  if (note && zone) note.textContent = `Times in your time zone, ${zone.replace(/_/g, ' ')}.`
  for (const node of document.querySelectorAll<HTMLElement>('.w-daytabs a, .w-sched__day')) {
    const day = node.dataset.day || ''
    node.classList.toggle('is-today', day === today)
    node.classList.toggle('is-past', day < today)
  }
</script>
