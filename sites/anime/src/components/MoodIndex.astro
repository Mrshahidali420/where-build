---
/**
 * /mood (drawn by pages/[hub].astro): every anime mood whose recipe found
 * enough shows (packages/core/src/where/moods.mjs, the `mood` gate), each
 * asked the way a viewer would ask it, with three of its covers.
 */
import Where from '@sister/core/src/layouts/Where.astro'
import config from '@sister/core/src/lib/site.mjs'
import { whereHubs } from '@sister/core/src/where/hub-data.mjs'
import { listJsonld } from '@sister/core/src/where/jsonld.mjs'
import { plural } from '@sister/core/src/where/words.mjs'
import HubHead from '@sister/core/src/components/where/HubHead.astro'
import CollageCards from '@sister/core/src/components/where/CollageCards.astro'

const hubs = whereHubs()
const moods = hubs.moodIndex
const firstSentence = (text) => (String(text || '').match(/^.*?[.!?](\s|$)/)?.[0] || '').trim()
const items = moods.map((m) => ({
  href: `/mood/${m.slug}`,
  title: m.ask,
  covers: m.covers,
  meta: `${m.title} · ${plural(m.count, 'show')}`,
  note: firstSentence(hubs.moods[m.slug]?.intro),
}))
const total = new Set(moods.flatMap((m) => hubs.moods[m.slug]?.rows.map((r) => r[1]) || [])).size
---

<Where
  title={`Anime by Mood: What to Watch Tonight | ${config.name}`}
  description={`Pick anime by how you want to feel: ${moods.slice(0, 5).map((m) => m.ask.toLowerCase()).join(', ')} and ${plural(moods.length - 5, 'more mood')}.`}
  canonical="/mood"
  jsonld={listJsonld('Anime by mood', moods.map((m) => ({ name: m.title, href: `/mood/${m.slug}` })), config.siteUrl)}
  crumbs={[{ name: 'Anime', href: '/anime' }, { name: 'Moods' }]}
>
  <HubHead
    kicker="What to watch tonight"
    title="Anime by mood"
    lede="Genres say what a show is. A mood says what you want from it tonight. Each list is built from the themes AniList tags every show with, so a show is on it because it carries them, not because we guessed."
    stats={[[String(moods.length), 'moods'], [total.toLocaleString('en-US'), 'shows']]}
  />
  <section class="w-sec" aria-label="Moods">
    <CollageCards items={items} eager={4} />
  </section>
</Where>
