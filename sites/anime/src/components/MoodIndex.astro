---
/**
 * /mood (drawn by pages/[hub].astro): every anime mood whose recipe found
 * enough shows (packages/core/src/where/moods.mjs, the `mood` gate), each
 * asked the way a viewer would ask it, with three of its covers.
 */
import Where from '@sister/core/src/layouts/Where.astro'
import config from '@sister/core/src/lib/site.mjs'
import { whereHubs } from '@sister/core/src/where/hub-data.mjs'
import { listJsonld } from '@sister/core/src/where/jsonld.mjs'
import { plural } from '@sister/core/src/where/words.mjs'

const moods = whereHubs().moodIndex
const small = (url) => String(url || '').replace('/cover/large/', '/cover/medium/')
---

<Where
  title={`Anime by Mood: What to Watch Tonight | ${config.name}`}
  description={`Pick anime by how you want to feel: ${moods.slice(0, 5).map((m) => m.ask.toLowerCase()).join(', ')} and ${plural(moods.length - 5, 'more mood')}.`}
  canonical="/mood"
  jsonld={listJsonld('Anime by mood', moods.map((m) => ({ name: m.title, href: `/mood/${m.slug}` })), config.siteUrl)}
  crumbs={[{ name: 'Anime', href: '/anime' }, { name: 'Moods' }]}
>
  <header class="w-intro">
    <p class="w-kicker">What to watch tonight</p>
    <h1>Anime by mood</h1>
    <p class="w-intro__lede">
      Genres say what a show is. A mood says what you want from it tonight. Each list below is built from the
      themes AniList tags every show with, so a show is on it because it carries them, not because we guessed.
    </p>
  </header>
  <ul class="w-moods">
    {
      moods.map((m, i) => (
        <li>
          <a href={`/mood/${m.slug}`}>
            <b>{m.ask}</b>
            <small>{m.title}, {plural(m.count, 'show')}</small>
            <span class="w-moods__covers" aria-hidden="true">
              {m.covers.map((src) => <img src={small(src)} alt="" width="36" height="52" loading={i < 6 ? 'eager' : 'lazy'} decoding="async" />)}
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</Where>
