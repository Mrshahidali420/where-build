---
/** Every anime genre with a page (the genre gate), biggest first: three covers, the count, the top show and one line on what the genre is. */
export const prerender = true
import Where from '@sister/core/src/layouts/Where.astro'
import config from '@sister/core/src/lib/site.mjs'
import HubHead from '@sister/core/src/components/where/HubHead.astro'
import CollageCards from '@sister/core/src/components/where/CollageCards.astro'
import { whereHubs } from '@sister/core/src/where/hub-data.mjs'
import { listJsonld } from '@sister/core/src/where/jsonld.mjs'
import { plural } from '@sister/core/src/where/words.mjs'

const genres = whereHubs().genreIndex
const items = genres.map((g) => ({
  href: `/genre/${g.slug}`,
  title: g.name,
  covers: g.covers,
  meta: `${plural(g.total, 'show')}${g.top ? ` · Top: ${g.top}` : ''}`,
  note: g.note,
}))
---

<Where
  title={`Anime Genres: ${genres.length} Genres, Most Watched First | ${config.name}`}
  description={`Anime by genre: ${genres.map((g) => g.name).slice(0, 8).join(', ')} and more, each with its most watched shows and their casts and staff.`}
  canonical="/genre"
  noindex={genres.length === 0}
  jsonld={listJsonld('Anime genres', genres.map((g) => ({ name: g.name, href: `/genre/${g.slug}` })), config.siteUrl)}
  crumbs={[{ name: 'Anime', href: '/anime' }, { name: 'Genres' }]}
>
  <HubHead
    kicker="Browse"
    title="Anime genres"
    lede="Every genre with enough shows for a real list, biggest first. Each opens its most watched shows, and most shows sit in two or three genres."
    stats={[[String(genres.length), 'genres']]}
  />
  <section class="w-sec" aria-label="Genres">
    <CollageCards items={items} eager={4} />
  </section>
</Where>
