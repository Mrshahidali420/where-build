---
/**
 * How to reach the people behind the site: a form that lands in the owner's
 * /my-admin/messages (packages/core/src/components/MessageForm.astro), and
 * the address from the config (email). Until a site has its own mailbox the
 * home site's contact page is named instead, which the same people read.
 */
export const prerender = true
import Where from '@sister/core/src/layouts/Where.astro'
import config from '@sister/core/src/lib/site.mjs'
import MessageForm from '@sister/core/src/components/MessageForm.astro'
import { homeBase } from '@sister/core/src/where/cross.mjs'

const home = homeBase(config)
---

<Where title={`Contact | ${config.name}`} description={`How to reach ${config.name}: wrong dates, missing credits and everything else.`} canonical="/contact" crumbs={[{ name: 'Contact' }]}>
  <header class="w-intro">
    <h1>Contact</h1>
  </header>
  <div class="prose">
    <p>
      Spotted a wrong air date, a missing voice actor or a credit on the wrong person? The
      <a href="/feedback">feedback form</a> is the quickest way to say so. For everything else, write here.
    </p>
  </div>

  <MessageForm kind="contact" />

  <div class="prose">
    <h2>By email</h2>
    {
      config.email ? (
        <p>Or write to <a href={`mailto:${config.email}`}>{config.email}</a>. Please include the address of the page.</p>
      ) : home ? (
        <p>
          Until {config.name} has its own mailbox, send your message through the
          <a href={`${home}/contact`} rel="noopener">contact page of our sister site</a>, and name the {config.name} page it is about.
        </p>
      ) : null
    }
    <h2>Before you write</h2>
    <p>
      Most of what you see comes from <a href="https://anilist.co" rel="noopener">AniList</a>, and a fix made there
      reaches this site with the next daily rebuild. Correcting AniList directly is often the fastest way.
    </p>
  </div>
</Where>
