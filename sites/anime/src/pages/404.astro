---
/**
 * The not-found page. It turns the address that was asked for back into
 * words and offers them to the search, and lists the ways in. The Worker
 * serves this file with a real 404 and no-store (src/lib/runtime.js).
 */
export const prerender = true
import Where from '@sister/core/src/layouts/Where.astro'
import config from '@sister/core/src/lib/site.mjs'
import stats from '@site/data/site-stats.json'

const gone = new Set(stats.missing || [])
const doors = config.nav.filter((link) => !gone.has(link.href))
---

<Where title={`Page not found | ${config.name}`} description="That page is not on this site." noindex={true} missing={true}>
  <section class="w-lost">
    <svg class="w-lost__mark" width="96" height="96" viewBox="0 0 32 32" aria-hidden="true" set:html={config.mark}></svg>
    <div>
      <p class="w-kicker">Error 404</p>
      <h1>This page is not on the map</h1>
      <p class="w-intro__lede">The link may be old, or that show, person or studio has no page yet. Search for it, or start from one of the lists below.</p>
      <form class="w-hero__search" role="search" action="/search" method="get">
        <label class="sr-only" for="lost-q">Search anime</label>
        <input id="lost-q" name="q" type="search" autocomplete="off" placeholder="Search anime" />
        <button class="btn" type="submit">Search</button>
      </form>
    </div>
  </section>
  <ul class="w-doors w-doors--list">
    {
      doors.map((link) => (
        <li>
          <a href={link.href}>
            <b>{link.label}</b>
            <span>{link.href}</span>
          </a>
        </li>
      ))
    }
  </ul>

  <script is:inline>
    // "/voice-actor/kana-hanazawa-2" -> "kana hanazawa", put in the search box.
    ;(function () {
      var raw = ''
      try {
        raw = decodeURIComponent(location.pathname)
      } catch (e) {
        raw = location.pathname
      }
      var words = (raw.split('/').filter(Boolean).pop() || '')
        .replace(/-\d{3,}$/, '')
        .replace(/[-_]+/g, ' ')
        .replace(/[^a-z0-9 ']/gi, ' ')
        .replace(/\s+/g, ' ')
        .trim()
      var input = document.getElementById('lost-q')
      if (words.length >= 3 && input) input.value = words
    })()
  </script>
</Where>
