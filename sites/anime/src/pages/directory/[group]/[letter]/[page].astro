---
/** A deeper page of one letter of a directory (page 2 and on). */
export const prerender = true
import DirectoryLetter from '../../../../components/DirectoryLetter.astro'
import { whereHubs } from '@sister/core/src/where/hub-data.mjs'
import { hubPaths } from '@sister/core/src/where/hubs.mjs'

export function getStaticPaths() {
  return hubPaths(whereHubs())
    .filter((p) => p.letter && p.page > 1)
    .map(({ group, letter, page, pages }) => ({ params: { group, letter, page: String(page) }, props: { page, pages } }))
}

const { group, letter } = Astro.params
const { page, pages } = Astro.props
---

<DirectoryLetter group={group} letter={letter} page={page} pages={pages} />
