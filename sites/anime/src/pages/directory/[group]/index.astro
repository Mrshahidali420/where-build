---
/**
 * The front of one directory (voice actors, staff, studios, song artists,
 * watch orders): the A to Z, and the busiest names first. Prerendered from
 * data/where-hubs.json (packages/core/src/where/hubs.mjs).
 */
export const prerender = true
import Where from '@sister/core/src/layouts/Where.astro'
import config from '@sister/core/src/lib/site.mjs'
import { whereHubs } from '@sister/core/src/where/hub-data.mjs'
import { GROUPS } from '@sister/core/src/where/hubs.mjs'
import { plural } from '@sister/core/src/where/words.mjs'
import LetterNav from '@sister/core/src/components/where/LetterNav.astro'
import NameList from '@sister/core/src/components/where/NameList.astro'

export function getStaticPaths() {
  return Object.keys(whereHubs().groups).map((group) => ({ params: { group } }))
}

const { group } = Astro.params
const dir = whereHubs().groups[group]
const meta = GROUPS[group]
const total = Object.values(dir.letters).reduce((n, rows) => n + rows.length, 0)
---

<Where
  title={`${meta.label} A to Z: ${plural(total, meta.noun, meta.many)} | ${config.name}`}
  description={`Every ${meta.noun} with a page on ${config.name}, A to Z: ${plural(total, meta.noun, meta.many)}, the busiest first.`}
  canonical={`/directory/${group}`}
  crumbs={[{ name: meta.label }]}
>
  <header class="w-front" style="padding-top:1rem">
    <h1>{meta.label}</h1>
    <p>{plural(total, meta.noun, meta.many)}, A to Z. Pick a letter, or start with the busiest below.</p>
  </header>
  <LetterNav group={group} letters={dir.letters} />
  <section class="w-sec" aria-labelledby="top">
    <h2 id="top">The busiest</h2>
    <NameList rows={dir.top} noun={meta.count} />
  </section>
</Where>
