---
/**
 * The front of one directory (voice actors, staff, studios, song artists,
 * watch orders): the first page of its most popular list, with the other
 * sorts and the A to Z above it. Prerendered from data/where-hubs.json
 * (packages/core/src/where/hubs.mjs).
 */
export const prerender = true
import DirectoryRank from '../../../components/DirectoryRank.astro'
import { whereHubs } from '@sister/core/src/where/hub-data.mjs'
import { DEFAULT_SORT, hubPaths } from '@sister/core/src/where/hubs.mjs'

export function getStaticPaths() {
  return hubPaths(whereHubs())
    .filter((p) => p.sort === DEFAULT_SORT && p.page === 1)
    .map(({ group, pages }) => ({ params: { group }, props: { pages } }))
}

const { pages } = Astro.props
---

<DirectoryRank group={Astro.params.group} sort={DEFAULT_SORT} page={1} pages={pages} />
