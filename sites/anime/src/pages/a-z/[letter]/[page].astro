---
/** A deeper page of one letter of the A to Z of every title (page 2 and on). */
export const prerender = true
import AzLetter from '../../../components/AzLetter.astro'
import { whereHubs } from '@sister/core/src/where/hub-data.mjs'
import { hubPaths } from '@sister/core/src/where/hubs.mjs'

export function getStaticPaths() {
  return hubPaths(whereHubs())
    .filter((p) => p.azLetter && p.page > 1)
    .map(({ azLetter, page, pages }) => ({ params: { letter: azLetter, page: String(page) }, props: { page, pages } }))
}

const { page, pages } = Astro.props
---

<AzLetter letter={Astro.params.letter} page={page} pages={pages} />
