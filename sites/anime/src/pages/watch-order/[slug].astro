---
/**
 * A franchise's watch order: every anime entry in release order, movies,
 * OVAs and specials included, with the main story marked. Anime only: the
 * franchise's manga and novels live on the home site.
 */
import Where from '@sister/core/src/layouts/Where.astro'
import config from '@sister/core/src/lib/site.mjs'
import { envOf, notFound, unavailable } from '@sister/core/src/lib/runtime.js'
import { loadWatchOrder } from '@sister/core/src/where/runtime.mjs'
import { listJsonld } from '@sister/core/src/where/jsonld.mjs'
import { formatWord, statusWord, plural } from '@sister/core/src/where/words.mjs'

let w
try {
  w = await loadWatchOrder(envOf(Astro), Astro.params.slug)
} catch (e) {
  return unavailable(Astro, e)
}
if (!w) return notFound(Astro)

const main = w.entries.filter((e) => e.main)
// A main story of one entry says nothing; the marks show only for a real chain.
const marked = main.length > 1
const years = w.entries.map((e) => e.year).filter(Boolean)
const span = years.length ? `${Math.min(...years)} to ${Math.max(...years)}` : ''
const episodes = w.entries.reduce((n, e) => n + (e.episodes || 0), 0)
const small = (url) => String(url || '').replace('/cover/large/', '/cover/medium/')
---

<Where
  title={`${w.name} Watch Order: All ${w.entries.length} Anime in Order | ${config.name}`}
  description={`How to watch ${w.name}: all ${plural(w.entries.length, 'anime', 'anime')} in release order${span ? ` (${span})` : ''}, with movies, OVAs and specials${main.length > 1 ? `, and the ${main.length} entries of the main story marked` : ''}.`}
  canonical={`/watch-order/${w.slug}`}
  image={w.entries[0]?.cover || undefined}
  jsonld={listJsonld(`${w.name} watch order`, w.entries, config.siteUrl)}
  crumbs={[{ name: 'Watch orders', href: '/directory/watch-orders' }, { name: w.name }]}
>
  <header class="w-intro">
    <p class="w-kicker">Watch order</p>
    <h1>{w.name} watch order</h1>
    <p class="w-intro__lede">
      {plural(w.entries.length, 'anime', 'anime')}{span ? `, ${span}` : ''}{episodes ? `, ${plural(episodes, 'episode')} in all` : ''}. Watch them from the top, in release order.
      {marked && <> The {main.length} entries marked main story follow one another as sequels; the rest are films, specials and side stories you can take or leave.</>}
    </p>
  </header>

  <section class="w-sec" aria-labelledby="order">
    <div class="w-sec__head">
      <h2 id="order">In release order</h2>
    </div>
    <ol class="w-order">
      {
        w.entries.map((e, i) => (
          <li class:list={[{ 'w-order--main': marked && e.main, 'w-order--extra': marked && !e.main }]}>
            <span class="w-order__n">{i + 1}</span>
            {e.cover ? <img class="w-order__art" src={small(e.cover)} alt="" width="56" height="80" loading={i < 6 ? 'eager' : 'lazy'} decoding="async" /> : <span class="w-order__art" />}
            <span class="w-order__what">
              <a href={e.href}>{e.title}</a>
              <small>{[e.year, formatWord(e.format), e.episodes ? plural(e.episodes, 'episode') : '', e.status && e.status !== 'FINISHED' ? statusWord(e.status) : ''].filter(Boolean).join(', ')}</small>
            </span>
            {marked && <span class="w-order__part">{e.main ? 'Main story' : 'Extra'}</span>}
          </li>
        ))
      }
    </ol>
  </section>
</Where>
