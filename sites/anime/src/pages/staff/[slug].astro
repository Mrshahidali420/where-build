---
/**
 * A member of an anime's staff: their work grouped by what they did
 * (directed, wrote, designed, composed...), and the people they keep working
 * with. Same shard record as their voice actor page; answers 404 unless the
 * staff gate let them in.
 */
import Where from '@sister/core/src/layouts/Where.astro'
import config from '@sister/core/src/lib/site.mjs'
import { envOf, notFound, unavailable } from '@sister/core/src/lib/runtime.js'
import { loadPerson } from '@sister/core/src/where/runtime.mjs'
import { personJsonld } from '@sister/core/src/where/jsonld.mjs'
import { plural } from '@sister/core/src/where/words.mjs'
import PersonHead from '@sister/core/src/components/where/PersonHead.astro'
import WorkRows from '@sister/core/src/components/where/WorkRows.astro'
import NameList from '@sister/core/src/components/where/NameList.astro'
import Bio from '@sister/core/src/components/where/Bio.astro'

let p
try {
  p = await loadPerson(envOf(Astro), Astro.params.slug)
} catch (e) {
  return unavailable(Astro, e)
}
if (!p || !p.staffPage) return notFound(Astro)

const OPEN = 20
const lead = [...p.works].sort((a, b) => b.items.length - a.items.length)[0]
// What the group says about the person, as the end of "most of all ...".
const AS = { created: 'as a creator', directed: 'as a director', wrote: 'as a writer', designed: 'as a designer', composed: 'in music and songs', animated: 'as an animator', sound: 'in sound', produced: 'as a producer' }
const lede = `Credited on ${plural(p.counts.shows, 'anime', 'anime')}` + (lead && AS[lead.key] ? `, most of all ${AS[lead.key]}.` : '.')
const known = lead ? lead.items.slice(0, 3).map((w) => w.title) : []
---

<Where
  title={`${p.name}: Anime Staff Credits | ${config.name}`}
  description={`The anime ${p.name} worked on${known.length ? `, including ${known.join(', ')}` : ''}, by role, with the people they work with most.`}
  canonical={p.staffHref}
  image={p.image || undefined}
  jsonld={personJsonld(p, p.staffHref, config.siteUrl)}
  crumbs={[{ name: 'Staff', href: '/directory/staff' }, { name: p.name }]}
>
  <PersonHead person={p} page="staff" lede={lede} />

  {
    p.works.map((group) => (
      <section class="w-sec" aria-labelledby={`g-${group.key}`}>
        <div class="w-sec__head">
          <h2 id={`g-${group.key}`}>{group.label}</h2>
          <p class="w-sec__count">{plural(group.items.length, 'anime', 'anime')}</p>
        </div>
        <WorkRows items={group.items.slice(0, OPEN)} />
        {group.items.length > OPEN && (
          <details class="w-fold w-fold--big">
            <summary>Show {plural(group.items.length - OPEN, 'more anime', 'more anime')}</summary>
            <WorkRows items={group.items.slice(OPEN)} />
          </details>
        )}
      </section>
    ))
  }

  {
    p.collaborators.length > 0 && (
      <section class="w-sec" aria-labelledby="with">
        <div class="w-sec__head">
          <h2 id="with">Works most often with</h2>
        </div>
        <NameList rows={p.collaborators} noun="shared show" />
      </section>
    )
  }

  <Bio text={p.bio} source={p.anilistUrl} heading={`About ${p.name}`} />
</Where>
