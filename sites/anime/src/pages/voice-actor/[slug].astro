---
/**
 * A voice actor: every role they have voiced in an anime on this site, newest
 * show first, with the character's face and the language. Same shard record
 * as their staff page; answers 404 unless the voice actor gate let them in.
 *
 * A busy actor has hundreds of roles. The first ROLES_OPEN are listed open;
 * the rest sit in one folded list in the same page (no second address to
 * crawl), drawn as compact rows so a long career stays a reasonable page.
 */
import Where from '@sister/core/src/layouts/Where.astro'
import config from '@sister/core/src/lib/site.mjs'
import { envOf, notFound, unavailable } from '@sister/core/src/lib/runtime.js'
import { loadPerson } from '@sister/core/src/where/runtime.mjs'
import { personJsonld } from '@sister/core/src/where/jsonld.mjs'
import { castRoleWord, plural } from '@sister/core/src/where/words.mjs'
import PersonHead from '@sister/core/src/components/where/PersonHead.astro'
import RoleRows from '@sister/core/src/components/where/RoleRows.astro'
import Bio from '@sister/core/src/components/where/Bio.astro'
import { voiceFacts } from '@sister/core/src/where/person-facts.mjs'

let p
try {
  p = await loadPerson(envOf(Astro), Astro.params.slug)
} catch (e) {
  return unavailable(Astro, e)
}
if (!p || !p.voicePage) return notFound(Astro)

const ROLES_OPEN = 40
const shows = new Set(p.roles.map((r) => r.href)).size
const mains = p.roles.filter((r) => r.role === 'MAIN')
const languages = [...new Set(p.roles.map((r) => r.language))]
const best = mains.slice(0, 3).map((r) => r.character.name)
const lede =
  `${plural(p.roles.length, 'role')} in ${plural(shows, 'anime', 'anime')}` +
  (mains.length ? `, ${mains.length} of them main characters` : '') +
  (languages.length === 1 ? `, in ${languages[0]}.` : '.')
const open = p.roles.slice(0, ROLES_OPEN)
// The character page's facts sheet, for a person: bio facts, role numbers.
const glance = voiceFacts(p)
const rest = p.roles.slice(ROLES_OPEN)
---

<Where
  title={`${p.name}: Voice Roles and Characters | ${config.name}`}
  description={`Every anime character ${p.name} voices${best.length ? `, including ${best.join(', ')}` : ''}: ${lede}`}
  canonical={p.voiceHref}
  image={p.image || undefined}
  jsonld={personJsonld(p, p.voiceHref, config.siteUrl)}
  crumbs={[{ name: 'Voice actors', href: '/directory/voice-actors' }, { name: p.name }]}
>
  <PersonHead person={p} page="voice" lede={lede} />

  {
    glance.rows.length > 2 && (
      <section class="w-sec" aria-labelledby="glance">
        <div class="w-sec__head">
          <h2 id="glance">{p.name} at a glance</h2>
        </div>
        <dl class="w-sheet w-sheet--wide">
          {glance.rows.map(([label, value]) => (
            <div>
              <dt>{label}</dt>
              <dd>{value}</dd>
            </div>
          ))}
        </dl>
      </section>
    )
  }

  <section class="w-sec" aria-labelledby="roles">
    <div class="w-sec__head">
      <h2 id="roles">Roles</h2>
      <p class="w-sec__count">{plural(p.roles.length, 'role')}</p>
    </div>
    <p class="w-sec__note">Newest show first. A character's name opens their profile on our sister site.</p>
    <RoleRows roles={open} roleWord={castRoleWord} />
    {
      rest.length > 0 && (
        <details class="w-fold w-fold--big">
          <summary>Show {plural(rest.length, 'more role')}</summary>
          <RoleRows roles={rest} roleWord={castRoleWord} />
        </details>
      )
    }
  </section>

  <Bio text={glance.bio} source={p.anilistUrl} heading={`About ${p.name}`} />
</Where>
