---
/**
 * Privacy, written from the config so it never claims a tool the site does
 * not run: Google Analytics only with a GA4 id, Turnstile only with a site
 * key, the Amazon Associates sentence only with a store tag (the owner's
 * rule: that sentence lives in the footer and here, never beside a link).
 */
export const prerender = true
import Where from '@sister/core/src/layouts/Where.astro'
import config from '@sister/core/src/lib/site.mjs'

// Only once the site has a tag in some store: before that no link earns anything.
const amazon = Object.values(config.amazon.stores).some(Boolean)
---

<Where title={`Privacy | ${config.name}`} description={`What ${config.name} records about a visit, and what it never does.`} canonical="/privacy" crumbs={[{ name: 'Privacy' }]}>
  <header class="w-intro">
    <h1>Privacy</h1>
  </header>
  <div class="prose">
    <p>{config.name} has no accounts and no logins. It never asks for your name or e-mail.</p>
    <h2>What a visit records</h2>
    <p>
      The site counts its own visits in its own database on Cloudflare: the page address and title, the site
      that sent you, the link you followed out, your country as Cloudflare reports it, and whether you are on a
      phone, with a random visitor number your browser keeps in its own storage so a return visit is not counted
      as a new person. It stores no IP address and shares none of this. Raw rows are deleted after 30 days; only
      daily totals are kept.
    </p>
    {
      config.turnstileSiteKey ? (
        <p>
          Nothing is counted until <strong>Cloudflare Turnstile</strong> has checked, invisibly, that a real
          browser is here. Turnstile is Cloudflare's own check and is covered by
          <a href="https://www.cloudflare.com/privacypolicy/" rel="noopener">Cloudflare's privacy policy</a>.
        </p>
      ) : (
        <p>Until the site's real-browser check is set up, nothing is recorded at all.</p>
      )
    }
    {
      config.ga4Id && (
        <p>
          We also use <strong>Google Analytics 4</strong> to count visits. You can block it with the
          <a href="https://tools.google.com/dlpage/gaoptout" rel="noopener nofollow">Google Analytics opt-out add-on</a>.
        </p>
      )
    }
    {
      amazon && (
        <>
          <h2>Amazon affiliate links</h2>
          <p>
            {config.name} is a participant in the Amazon Services LLC Associates Program, an affiliate advertising
            program designed to provide a means for sites to earn advertising fees by advertising and linking to
            Amazon.com. As an Amazon Associate we earn from qualifying purchases.
          </p>
        </>
      )
    }
    <h2 id="your-list">Your list</h2>
    <p>
      <a href="/my-list">My list</a> is kept in your own browser's storage, on this device only. The anime you
      save, their statuses and your named lists are never sent to us, and nothing links them to you. Clearing the
      site's data in your browser, or the button at the bottom of My list, removes them. To show a saved show's next
      episode, the page downloads small public files that each hold dozens of shows, and the site keeps no
      record of which ones a browser asked for.
    </p>
    <p>
      The AniList import asks AniList for a public list straight from your browser. The username you type goes to
      AniList, never to us, and AniList's own privacy policy covers that request.
    </p>
    <h2>Links out</h2>
    <p>
      Links to AniList, to streaming services and to other sites open those sites under their own privacy
      policies, and a link to a shop, Amazon included, opens that shop under its own. Covers and photos load from AniList's image server. A trailer loads YouTube's privacy-enhanced player only after you press play.
    </p>
  </div>
</Where>
