// Written by packages/core/scripts/make-wrangler.mjs from site.config.mjs.
// Do not edit it by hand: change the config and run `npm run wrangler`.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "whereanime",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "none",
    "html_handling": "auto-trailing-slash",
    "binding": "ASSETS",
    "run_worker_first": [
      "/robots.txt"
    ]
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "ANALYTICS",
      "database_name": "whereanime-analytics",
      "database_id": "cf342163-4a44-42b2-b427-49196cf9d333"
    }
  ],
  "triggers": {
    "crons": [
      "10 0 * * *"
    ]
  }
}
