---
/**
 * Opening and ending songs: OP1 "Title" by Artist, with the episodes each one
 * plays over. An artist links to their page when they have one.
 *
 * With `listen`, each song also gets three searches for it, the home site's
 * way: YouTube, Spotify and Amazon (src/where/shop.mjs songListen). A search
 * claims nothing about what it finds, so none is called "official". Each link
 * carries data-go="song" and its own data-platform for the click tracker; the
 * Amazon one is an affiliate link (data-aff="music"). `country` picks the
 * reader's Amazon store.
 */
import { songListen } from '../../where/shop.mjs'

const { songs = [], listen = false, country = '' } = Astro.props
const NAMES = { OP: 'Opening', ED: 'Ending' }
---

<ol class="w-songs">
  {
    songs.map((s) => {
      const links = listen ? songListen(s, country) : []
      return (
        <li>
          <span class="w-songs__tag" title={`${NAMES[s.type] || s.type} ${s.seq || 1}`}>
            {s.type}
            {s.seq || ''}
          </span>
          <span class="w-songs__what">
            <b>“{s.title}”</b>
            {s.artists.length > 0 && (
              <span class="w-songs__by">
                {'by '}
                {s.artists.map((a, i) => (
                  <>
                    {i > 0 && ', '}
                    {a.href ? <a href={a.href}>{a.name}</a> : a.name}
                  </>
                ))}
              </span>
            )}
            {links.length > 0 && (
              <span class="w-songs__listen">
                {links.map((link) => (
                  <a
                    href={link.url}
                    rel={link.rel}
                    target="_blank"
                    data-go="song"
                    data-platform={link.label}
                    data-aff={link.aff}
                    data-aff-src={link.aff ? 'themes' : undefined}
                    aria-label={`Search ${link.label} for ${link.terms}`}
                  >
                    {link.label}
                  </a>
                ))}
              </span>
            )}
          </span>
          {s.episodes && <span class="w-songs__eps">Episodes {s.episodes}</span>}
        </li>
      )
    })
  }
</ol>
