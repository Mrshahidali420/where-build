---
/**
 * Opening and ending songs: OP1 "Title" by Artist, with the episodes each one
 * plays over. An artist links to their page when they have one. No audio, no
 * video and no shop links: the sources cannot license the footage, and this
 * site carries no shop links (docs/PLAN.md section 2.1).
 */
const { songs = [] } = Astro.props
---

<ul class="w-songs">
  {
    songs.map((s) => (
      <li>
        <span class="w-songs__tag">{s.type}{s.seq || ''}</span>
        <span>
          <b>“{s.title}”</b>
          {s.artists.length > 0 && (
            <>
              {' by '}
              {s.artists.map((a, i) => (
                <>
                  {i > 0 && ', '}
                  {a.href ? <a href={a.href}>{a.name}</a> : a.name}
                </>
              ))}
            </>
          )}
        </span>
        {s.episodes && <span class="w-songs__eps">Episodes {s.episodes}</span>}
      </li>
    ))
  }
</ul>
