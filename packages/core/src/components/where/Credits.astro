---
/**
 * Who made the show: the studio and the key credits first, each linked to
 * its page when it has one, then the rest of the crew, folded when it is long.
 */
const { studios = [], keyCredits = [], crew = [] } = Astro.props
const rows = [...(studios.length ? [{ label: studios.length > 1 ? 'Studios' : 'Studio', people: studios }] : []), ...keyCredits]
const OPEN_CREW = 12
---

{
  rows.length > 0 && (
    <dl class="w-credits">
      {rows.map((row) => (
        <div>
          <dt>{row.label}</dt>
          <dd>
            {row.people.map((p, i) => (
              <>
                {i > 0 && ', '}
                {p.href ? <a href={p.href}>{p.name}</a> : p.name}
              </>
            ))}
          </dd>
        </div>
      ))}
    </dl>
  )
}
{
  crew.length > 0 && (
    <details class="w-fold" open={crew.length <= OPEN_CREW}>
      <summary>Full crew, {crew.length} credits</summary>
      <ul class="w-crew">
        {crew.map((c) => (
          <li>
            {c.href ? <a href={c.href}>{c.name}</a> : c.name} <span>{c.role}</span>
          </li>
        ))}
      </ul>
    </details>
  )
}
