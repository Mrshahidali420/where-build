---
/**
 * The head of a voice actor or staff page: photo, name, the facts staff.json
 * holds, and a link to the same person's other page when they have one (a
 * singer who also voices, a director who once acted).
 *   page: 'voice' | 'staff'
 */
import { birthWords } from '../../where/words.mjs'

const { person: p, page, lede = '' } = Astro.props
const years = (p.yearsActive || []).filter(Boolean)
const facts = [
  ['Born', birthWords(p.birthDate)],
  ['Hometown', p.homeTown],
  ['Active', years.length ? (years.length > 1 ? `${years[0]} to ${years[1]}` : `Since ${years[0]}`) : ''],
  ['Work', (p.occupations || []).join(', ')],
].filter(([, value]) => value)
const other = page === 'voice' ? p.staffHref && { href: p.staffHref, label: `Crew credits of ${p.name}` } : p.voiceHref && { href: p.voiceHref, label: `Voice roles of ${p.name}` }
---

<header class="w-head w-head--person">
  {
    p.image ? (
      <img class="w-head__pic w-head__pic--round" src={p.image} alt={`Photo of ${p.name}`} width="160" height="160" fetchpriority="high" />
    ) : (
      <span class="w-head__pic w-head__pic--round w-head__pic--none" aria-hidden="true">{p.name.slice(0, 1)}</span>
    )
  }
  <div class="w-head__body">
    <p class="w-kicker">{page === 'voice' ? 'Voice actor' : 'Anime staff'}{p.language ? `, ${p.language}` : ''}</p>
    <h1>{p.name}</h1>
    {(p.native || p.aliases?.length > 0) && <p class="w-head__alt">{[p.native, ...(p.aliases || [])].filter(Boolean).join(' / ')}</p>}
    {lede && <p class="w-head__lede">{lede}</p>}
    {facts.length > 0 && (
      <dl class="w-facts">
        {facts.map(([label, value]) => (
          <div>
            <dt>{label}</dt>
            <dd>{value}</dd>
          </div>
        ))}
      </dl>
    )}
    {other && <a class="w-more" href={other.href}>{other.label}</a>}
  </div>
</header>
