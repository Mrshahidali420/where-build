---
/**
 * Where a title sits in its franchise's watch order, with the entries either
 * side and a link to the full order.
 */
const { watch } = Astro.props
---

{
  watch && (
    <div class="w-watch">
      <p class="w-watch__where">
        <span class="w-watch__pos">
          {watch.position}
          <small>of {watch.total}</small>
        </span>
        <span>
          In the <a href={watch.href}>{watch.name} watch order</a>, counted in release order.
        </span>
      </p>
      {(watch.prev || watch.next) && (
        <div class="w-watch__steps">
          {watch.prev ? (
            <a href={watch.prev.href}>
              <small>Watch before</small>
              {watch.prev.title}
              {watch.prev.year ? ` (${watch.prev.year})` : ''}
            </a>
          ) : (
            <span class="w-watch__none">This is where it starts.</span>
          )}
          {watch.next ? (
            <a href={watch.next.href}>
              <small>Watch after</small>
              {watch.next.title}
              {watch.next.year ? ` (${watch.next.year})` : ''}
            </a>
          ) : (
            <span class="w-watch__none">Nothing comes after it yet.</span>
          )}
        </div>
      )}
    </div>
  )
}
