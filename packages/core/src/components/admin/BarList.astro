---
/**
 * A short ranked list: a name on the left, one number on the right, and a
 * soft bar behind each row that shows its size next to the top row. Long
 * names are cut with "…", so the list never pushes the page sideways.
 *
 * rows: [{ name, href?, sub?, value, unit?, bar?, tone?, parts?, icon?, delta?, target? }]
 *   bar:    the bar width in percent. Without it, a number value is measured
 *           against the biggest number in the list.
 *   parts:  [{ n, tone }] splits the bar in colours (read and watch).
 *   icon:   a platform name; its logo is drawn in front of the name.
 *   delta:  { dir, words } from deltaOf(), written first in the small line.
 *   target: true for a link that leaves the site (new tab, nofollow).
 * tone: the bar colour for the whole list (blue, violet, amber, good, bad).
 */
import PlatformIcon from './PlatformIcon.astro'
import { num } from '../../lib/admin.js'
import { share } from '../../lib/admin-chart.js'

const { rows = [], empty = 'Nothing yet.', tone = 'blue' } = Astro.props
const max = Math.max(0, ...rows.map((row) => (typeof row.value === 'number' ? row.value : 0)))
const width = (row) =>
  row.bar != null ? Math.min(100, Math.max(0, row.bar)) : typeof row.value === 'number' ? share(row.value, max) : 0
const totalOf = (row) => (row.parts || []).reduce((n, p) => n + (p.n || 0), 0) || 1
const ARROW = { up: '▲ ', down: '▼ ' }
const outside = { target: '_blank', rel: 'noopener nofollow' }
---

{rows.length === 0 && <p class="empty">{empty}</p>}
{rows.length > 0 && (
  <ol class="bars">
    {rows.map((row) => (
      <li class:list={{ 'has-icon': row.icon }}>
        {row.parts ? (
          <span class="fill" style={`width:${width(row)}%;opacity:.24`} aria-hidden="true">
            {row.parts.map((p) => p.n > 0 && (
              <span class={`bg-${p.tone}`} style={`width:${(p.n / totalOf(row)) * 100}%`}></span>
            ))}
          </span>
        ) : (
          <span class={`fill solid tone-${row.tone || tone}`} style={`width:${width(row)}%`} aria-hidden="true"></span>
        )}
        {row.icon && <PlatformIcon name={row.icon} />}
        <span class="name">
          {row.href ? (
            <a href={row.href} title={row.name} {...(row.target ? outside : {})}>{row.name}</a>
          ) : (
            <span title={row.name}>{row.name}</span>
          )}
          {(row.sub || (row.delta && row.delta.words)) && (
            <span class="sub">
              {row.delta && row.delta.words && (
                <span class={row.delta.dir}>
                  <span aria-hidden="true">{ARROW[row.delta.dir] || ''}</span>{row.delta.words}
                </span>
              )}
              {row.delta && row.delta.words && row.sub && ' · '}
              {row.sub}
            </span>
          )}
        </span>
        <span class="val">
          {typeof row.value === 'number' ? num(row.value) : row.value}
          {row.unit && <small>{row.unit}</small>}
        </span>
      </li>
    ))}
  </ol>
)}
