---
/**
 * One platform tile. The same square everywhere on the site.
 *
 * The logo file is our own copy, served from /brand/. The tile is the brand
 * colour, so a row of platforms still reads as a set and not as a pile of
 * loose logos. A dark logo gets a pale plate under it, decided at build time.
 *
 * It is aria-hidden on purpose: the platform name is always written next to
 * it, so a screen reader saying the name twice is noise, not help.
 */
import { markOf } from '../lib/format.js'

const { site, size = '2.1rem', class: extra = '' } = Astro.props
const mark = markOf(site)
const kind = mark.src ? (mark.plate ? 'mark--plate' : 'mark--logo') : 'mark--letters'
---

<span
  class={`mark ${kind} ${extra}`.trim()}
  style={`--mark:${mark.color}; --mark-size:${size}`}
  aria-hidden="true"
>
  {
    mark.src ? (
      <img src={mark.src} alt={`${site} logo`} width="96" height="96" loading="lazy" decoding="async" />
    ) : (
      <b>{mark.initials}</b>
    )
  }
</span>
