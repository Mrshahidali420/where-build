---
import '../styles/app.css'
import config from '../lib/site.mjs'
import { hasRoute, isDevHost } from '../lib/define-site.mjs'
import { DOCK_ICONS } from '../lib/dock-icons.js'
// The page counter and Google Analytics, sent inside every page as they are.
// Only the site's own ids are filled in. Without a GA4 id Google's script is
// never fetched: miGoogleLoaded then starts out true.
import counterRaw from './counter-script.js?raw'
// The site's own type when its config ships it (fonts.self): the @fontsource
// stylesheets, and the hashed URLs of the faces the first screen paints. A
// site on a font service gets an empty list and keeps its stylesheet link.
import { fontPreload } from 'virtual:site-fonts'
// The shell shows only three numbers and eight genre names, so it reads a
// tiny file instead of the catalog. That keeps the Worker bundle small.
import stats from '@site/data/site-stats.json'

const {
  title,
  description,
  canonical = Astro.url.pathname,
  image,
  jsonld,
  crumbs = [],
  preloadImage,
  noindex = false,
  // Set only by the 404 page. It makes the counter record the address that
  // was asked for, so a broken link can be found and fixed.
  missing = false,
} = Astro.props

const site = config.siteUrl
// build.format 'file' leaves '.html' on Astro.url.pathname; public URLs never carry it.
const cleanPath = canonical.replace(/\.html$/, '').replace(/^\/index$/, '/') || '/'
const canonicalUrl = new URL(cleanPath, site).href
// The main menu, from the config (the reader's own saved titles are the
// last link on a site that builds src/pages/my-list.astro).
const nav = config.nav
const here = Astro.url.pathname
const footGenres = stats.genres

// A Workers dev address is never indexed (src/lib/dev-guard.js). A page built
// as a file reads the site's address at build time, which is the dev host
// until the site has a domain, so it carries the tag too.
const devHost = isDevHost(Astro.url.hostname)

// The legal pages in the footer, each only when the site builds it. A site
// with its own about and privacy pages names them in footer.legal.
const legal = config.footer.legal
  ? config.footer.legal.map((link) => [link.href, link.href, link.label])
  : [
      ['about', '/about', 'About'],
      ['contact', '/contact', 'Contact'],
      ['privacy', '/privacy', 'Privacy'],
      ['dmca', '/dmca', 'Copyright / DMCA'],
    ].filter(([key]) => hasRoute(config, key))

const counterScript = counterRaw
  .replaceAll('__GA4_ID__', config.ga4Id || '')
  .replace('__NO_GA4__', config.ga4Id ? 'false' : 'true')
  .replace('__TURNSTILE_SITEKEY__', config.turnstileSiteKey || '')

// The search box says how much there is to search. It used to say a number
// typed in by hand, which went stale the day after it was typed. This one
// comes from the build, rounded down to a round thousand so it reads as a
// claim and not as a false precision.
const searchable = Math.floor((stats.comics + stats.anime) / 1000) * 1000
const searchLabel = `Search ${searchable.toLocaleString()}+ titles…`
const year = new Date().getUTCFullYear()

// One brand entity, on every page, so each page is a self-contained
// answer for a search engine that only ever reads this one URL.
const organization = {
  '@type': 'Organization',
  '@id': `${site}/#organization`,
  name: config.name,
  url: site,
  logo: `${site}/logo.svg`,
  description: config.description,
  ...(config.email ? { email: config.email } : {}),
}

// Breadcrumbs. Home is always the first step, so pages pass only the
// steps after it. The last step is the page itself and carries no link.
const breadcrumbs =
  crumbs.length > 0
    ? {
        '@type': 'BreadcrumbList',
        itemListElement: [{ name: 'Home', href: '/' }, ...crumbs].map((step, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: step.name,
          ...(step.href ? { item: new URL(step.href, site).href } : {}),
        })),
      }
    : null

// Everything the page declares travels in one @graph, so the parts can
// reference each other by @id.
const nodes = [
  organization,
  ...(jsonld ? (Array.isArray(jsonld) ? jsonld : [jsonld]) : []).map(({ '@context': _c, ...node }) => ({
    ...node,
    isPartOf: { '@id': `${site}/#website` },
  })),
  {
    '@type': 'WebSite',
    '@id': `${site}/#website`,
    url: site,
    name: config.name,
    publisher: { '@id': organization['@id'] },
    potentialAction: {
      '@type': 'SearchAction',
      target: { '@type': 'EntryPoint', urlTemplate: `${site}/search?q={search_term_string}` },
      'query-input': 'required name=search_term_string',
    },
  },
  ...(breadcrumbs ? [breadcrumbs] : []),
]
const graph = nodes.length > 0 ? { '@context': 'https://schema.org', '@graph': nodes } : null
---

<!doctype html>
<html lang="en" data-missing={missing ? '1' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="theme-color" content={config.colors.night} />
    {devHost ? <meta name="robots" content="noindex,nofollow" /> : noindex && <meta name="robots" content="noindex,follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={config.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={image || `${site}/og-image.png`} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    {config.fonts.stylesheet && <link rel="preconnect" href="https://fonts.googleapis.com" />}
    {config.fonts.stylesheet && <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />}
    {config.fonts.stylesheet && (
      <link
        rel="stylesheet"
        href={config.fonts.stylesheet}
        media="print"
        onload="this.media='all'"
      />
    )}
    {config.fonts.stylesheet && (
      <noscript
        ><link
          rel="stylesheet"
          href={config.fonts.stylesheet}
      /></noscript>
    )}
    {fontPreload.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
    <link rel="preconnect" href="https://s4.anilist.co" />
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}

    {graph && <script type="application/ld+json" set:html={JSON.stringify(graph).replace(/</g, '\\u003c')} />}


    <!-- Google Analytics 4. Declared in /privacy. Google's own script is not
         here: it is fetched further down, and only once a real browser has
         been proved. Until then every gtag call simply waits in dataLayer,
         which is what dataLayer is for. -->
    <script is:inline set:html={counterScript}></script>

    <!-- Google AdSense. Declared in /privacy. The tag is loaded on every page,
         but nothing is shown until Google approves the site, and no ad slot is
         placed in the markup yet. `async` keeps it off the critical path. -->
    {config.adsensePub && <meta name="google-adsense-account" content={config.adsensePub} />}
    {config.adsensePub && (
      <script
        is:inline
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${config.adsensePub}`}
        crossorigin="anonymous"></script>
    )}
  </head>

  <body>
    <!--
    DIRECTION CONTRACT — Cyclorama Dawn
    THESIS: Every page is a lit stage at dawn: depthless cyc black, a cobalt
    horizon, rose light gathering above it; cover art stands on the horizon
    band like actors against a Shinkai sky.
    OWN-WORLD: stagecraft-theater-lighting-cyclorama-dawn — cyc black ground,
    cobalt horizon structure, rose gather, white-day reserved for the active
    state; lighting-plot stencil caps for cue names with tabular numerals;
    content stacked in horizon bands from dark to light; phases named in text
    (night, first light, dawn, hold, day) so colour is never the sole signal.
    STORY: a visitor walks in during the night cue and the answer is already
    standing lit at the horizon.
    FIRST VIEWPORT: black sky, cobalt-to-rose horizon glow, the headline above
    the line, a skyline of covers standing on it.
    FORM: horizon-band index; list position challenger-cyclorama; seed 0a16551e.
    FINISH: unreviewed and undocumented is unfinished; this build ends with the
    finish review, the verdict, DESIGN.md, and every shipping raster carrying
    its provenance.
    -->
    <a class="skip" href="#main">Skip to content</a>

    <header class="masthead">
      <div class="shell masthead__inner">
        <div class="masthead__brand">
        <a class="wordmark" href="/" aria-label={`${config.shortName} home`}>
          <svg class="wordmark__mark" width="22" height="22" viewBox="0 0 32 32" aria-hidden="true" set:html={config.mark}></svg>
          {config.wordmark[0]}<span>{config.wordmark[1]}</span>
        </a>
          <span class="masthead__tag">{config.tagline}</span>
        </div>

        <button
          class="menu-btn"
          type="button"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="site-menu"
        >
          <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true">
            <path class="menu-btn__bars" d="M3 6h16M3 11h16M3 16h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
            <path class="menu-btn__x" d="M5 5l12 12M17 5L5 17" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
        </button>

        <div class="masthead__menu" id="site-menu">
          <form class="finder" id="finder" role="search" action="/search" method="get">
            <svg class="finder__icon" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <circle cx="11" cy="11" r="7" />
              <path d="M20 20l-3.6-3.6" />
            </svg>
            <input
              id="finder-input"
              name="q"
              type="search"
              placeholder={searchLabel}
              autocomplete="off"
              aria-label="Search titles"
              role="combobox"
              aria-expanded="false"
              aria-controls="finder-results"
              aria-autocomplete="list"
            />
            <ul id="finder-results" role="listbox" hidden></ul>
            <span id="finder-status" class="sr-only" aria-live="polite"></span>
          </form>

          <nav aria-label="Browse">
            <a href="/" class="nav-home">Home</a>
            {
              nav.map((item) => (
                <a href={item.href} aria-current={here.startsWith(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              ))
            }
          </nav>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="colophon">
      <div class="shell colophon__grid">
        <div class="colophon__brand">
          <a class="wordmark" href="/">{config.wordmark[0]}<span>{config.wordmark[1]}</span></a>
          <p>
            {config.footer.blurb}
          </p>
          <p class="colophon__count">Refreshed every day.</p>
        </div>
        {config.footer.browse.length > 0 && (
          <div>
            <h3>Browse</h3>
            <ul>
              {config.footer.browse.map((link) => (
                <li><a href={link.href}>{link.label}</a></li>
              ))}
            </ul>
          </div>
        )}
        {hasRoute(config, 'genres') && (
          <div>
            <h3>Genres</h3>
            <ul>
              {footGenres.map((g) => (
                <li><a href={`/genre/${g.slug}`}>{g.name}</a></li>
              ))}
              <li><a href="/genre">All genres</a></li>
            </ul>
          </div>
        )}
        <div>
          <h3>About the data</h3>
          <p>
            Title data, scores and cover art come from
            <a href="https://anilist.co" rel="noopener">AniList</a>. Cover art belongs to
            its publishers. Availability changes often — when a link looks wrong, check
            the platform directly. The index rebuilds itself every day at {config.rebuildUtc} UTC, so
            broken links fix themselves.
          </p>
          <p>
            {config.name} is not affiliated with any publisher or streaming service.
          </p>
          {config.amazon.stores.us && (
            <p>
              Some links to shops are affiliate links. They cost you nothing extra. As an
              Amazon Associate we earn from qualifying purchases.
            </p>
          )}
          {legal.length > 0 && (
            <ul class="colophon__legal">
              {legal.map(([, href, label]) => (
                <li><a href={href}>{label}</a></li>
              ))}
            </ul>
          )}
        </div>
      </div>
      <div class="shell colophon__bar">
        <span>© {year} {config.name}</span>
        <span>{config.footer.bar}</span>
      </div>
    </footer>

    {config.dock.length > 0 && (
      <nav class="dock" aria-label="Quick links">
        {config.dock.map((item) => (
          <a href={item.href} class={here === item.href ? 'dock__on' : undefined}>
            <svg viewBox="0 0 24 24" aria-hidden="true" set:html={DOCK_ICONS[item.icon]}></svg>
            {item.label}
          </a>
        ))}
      </nav>
    )}

    <script>
      // The header search dropdown: src/lib/finder-dropdown.js.
      import '../lib/finder-dropdown.js'


      // Mobile menu: the button shows and hides the search + nav panel.
      const menuBtn = document.querySelector('.menu-btn')
      menuBtn.addEventListener('click', () => {
        const open = document.body.classList.toggle('menu-open')
        menuBtn.setAttribute('aria-expanded', String(open))
        menuBtn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu')
        if (open) document.getElementById('finder-input').focus()
      })
    </script>
  </body>
</html>
