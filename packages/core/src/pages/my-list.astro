---
// The reader's own list. One static page, identical for everybody: the list
// itself lives in their browser (src/lib/my-list.js) and the script below
// draws it. That is why it can be prerendered and cached like any other file,
// and why there is nothing on it for a search engine: it is noindex.
export const prerender = true
import Base from '../layouts/Base.astro'
import config from '../lib/site.mjs'
---

<Base
  title={`My list — ${config.name}`}
  description={`The titles you saved on ${config.name}, kept in your own browser. No account needed.`}
  canonical="/my-list"
  noindex
>
  <div class="shell ml">
    <section class="section">
      <div class="section__head">
        <h1>My list</h1>
        <p>
          Your list stays in your browser. We are checking how many people make lists.
          If enough people do, we will add accounts, so your list can sync between
          devices. <a href="/privacy#your-list">How it works</a>
        </p>
      </div>

      <p class="ml-blocked empty" hidden>
        <strong>Your browser is blocking storage.</strong> The list works while this tab is
        open, but it will be gone when you close it. Private windows and strict privacy
        settings do this.
      </p>

      <section class="ml-alerts" aria-labelledby="ml-alerts-h" hidden>
        <h2 id="ml-alerts-h">News about your titles</h2>
        <ul class="ml-alerts__list"></ul>
      </section>

      <section class="ml-week" aria-labelledby="ml-week-h" hidden>
        <h2 id="ml-week-h">This week</h2>
        <ul class="ml-week__list"></ul>
      </section>

      <div class="ml-tabbar">
        <div class="ml-tabs" role="tablist" aria-label="Your lists"></div>
        <button type="button" class="ml-btn ml-btn--ghost ml-newbtn" aria-expanded="false" aria-controls="ml-newlist">
          + New list
        </button>
      </div>
      <form class="ml-form" id="ml-newlist" hidden>
        <label for="ml-newlist-name">Name of the new list</label>
        <div class="ml-form__row">
          <input id="ml-newlist-name" maxlength="40" autocomplete="off" placeholder="Weekend binge" />
          <button type="submit" class="ml-btn">Create</button>
          <button type="button" class="ml-btn ml-btn--ghost ml-cancel">Cancel</button>
        </div>
      </form>
      <p class="ml-msg" role="status" aria-live="polite"></p>

      <div class="ml-panel" role="tabpanel" id="ml-panel" tabindex="-1">
        <div class="ml-listbar" hidden>
          <p class="ml-listbar__name"></p>
          <button type="button" class="ml-btn ml-btn--ghost ml-rename">Rename</button>
          <button type="button" class="ml-btn ml-btn--ghost ml-delete">Delete list</button>
        </div>
        <form class="ml-form ml-renameform" hidden>
          <label for="ml-rename-name">New name</label>
          <div class="ml-form__row">
            <input id="ml-rename-name" maxlength="40" autocomplete="off" />
            <button type="submit" class="ml-btn">Save</button>
            <button type="button" class="ml-btn ml-btn--ghost ml-cancel">Cancel</button>
          </div>
        </form>
        <p class="ml-count"></p>
        <ul class="ml-items"></ul>
        <div class="ml-empty empty" hidden>
          <p class="ml-empty__text"></p>
          <p>
            Browse <a href="/manhwa">manhwa</a>, <a href="/manga">manga</a>,
            <a href="/manhua">manhua</a>, <a href="/novel">novels</a> or
            <a href="/anime">anime</a> and tap <b>Add to my list</b> on any title.
          </p>
        </div>
      </div>

      <section class="ml-import" aria-labelledby="ml-import-h">
        <h2 id="ml-import-h">Import from AniList</h2>
        <p>
          Already track on AniList? Bring your public list across, custom lists included.
          Your browser asks AniList directly; the username never reaches us. AniList wins
          on status and progress for titles you already saved here.
        </p>
        <form class="ml-form ml-importform">
          <label for="ml-anilist-user">AniList username</label>
          <div class="ml-form__row">
            <input id="ml-anilist-user" maxlength="30" autocomplete="username" spellcheck="false" placeholder="your-name" />
            <button type="submit" class="ml-btn">Import</button>
          </div>
        </form>
        <p class="ml-import__msg" role="status" aria-live="polite"></p>
      </section>

      <section class="ml-danger">
        <button type="button" class="ml-btn ml-btn--ghost ml-clear">Clear my whole list</button>
      </section>
    </section>
  </div>

  <script>
    import '../lib/my-list-page.js'
  </script>
</Base>
